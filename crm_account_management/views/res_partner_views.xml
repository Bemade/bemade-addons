<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_inherit_crm_account_management" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.crm.account.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="5"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_organizational_unit"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-building-o"
                        invisible="not owned_organizational_unit_ids and not organizational_unit_ids">
                    <span class="o_stat_text">Customer Account</span>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="owned_organizational_unit_ids" widget="many2many_tags" readonly="1"
                       invisible="not owned_organizational_unit_ids"/>
                <field name="organizational_unit_ids" widget="many2many_tags"
                       invisible="not organizational_unit_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
