<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Nightly cron to refresh all OU metrics -->
    <record id="ir_cron_refresh_ou_metrics" model="ir.cron">
        <field name="name">Refresh Customer Account Metrics</field>
        <field name="model_id" ref="model_organizational_unit"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_metrics()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
