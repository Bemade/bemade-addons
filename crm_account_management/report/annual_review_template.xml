<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_annual_review">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Annual Review</h2>
                        <h3 class="text-center text-muted" t-field="doc.name"/>
                        <p class="text-center text-muted">
                            Report generated: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                        </p>

                        <hr/>

                        <!-- Sales Summary -->
                        <h4>Sales Summary</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td><strong>YTD Sales</strong></td>
                                    <td class="text-end">
                                        <span t-field="doc.ytd_sales" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>YTD Sales (Prior Year)</strong></td>
                                    <td class="text-end">
                                        <span t-field="doc.ytd_sales_prior_year" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Year-over-Year Change</strong></td>
                                    <td class="text-end">
                                        <t t-if="doc.ytd_sales_change_pct >= 0">
                                            <span class="text-success">
                                                +<span t-esc="'%.1f' % (doc.ytd_sales_change_pct * 100)"/>%
                                            </span>
                                        </t>
                                        <t t-else="">
                                            <span class="text-danger">
                                                <span t-esc="'%.1f' % (doc.ytd_sales_change_pct * 100)"/>%
                                            </span>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Quotations & Orders -->
                        <h4 class="mt-4">Quotations &amp; Orders</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Open Quotations</td>
                                    <td class="text-end"><span t-esc="doc.open_quotations_count"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.open_quotations_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Won Quotations (YTD)</td>
                                    <td class="text-end"><span t-esc="doc.won_quotations_count"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.won_quotations_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Open Orders</td>
                                    <td class="text-end"><span t-esc="doc.open_orders_count"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.open_orders_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Opportunities -->
                        <h4 class="mt-4">Opportunities</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Metric</th>
                                    <th class="text-end">Count</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Open Opportunities</td>
                                    <td class="text-end"><span t-esc="doc.open_opportunities_count"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.open_opportunities_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Won Opportunities (YTD)</td>
                                    <td class="text-end"><span t-esc="doc.won_opportunities_count"/></td>
                                    <td class="text-end">
                                        <span t-field="doc.won_opportunities_amount" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Top Products -->
                        <h4 class="mt-4">Top Products (Last 12 Months)</h4>
                        <t t-set="top_products" t-value="doc.get_top_products(limit=10)"/>
                        <t t-if="top_products">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="top_products" t-as="product">
                                        <tr>
                                            <td><span t-esc="product_index + 1"/></td>
                                            <td><span t-esc="product['product_name']"/></td>
                                            <td class="text-end"><span t-esc="'%.2f' % product['total_qty']"/></td>
                                            <td class="text-end">
                                                <span t-esc="'%.2f' % product['total_amount']"/> 
                                                <span t-esc="doc.currency_id.symbol"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No product data available for this period.</p>
                        </t>

                        <!-- Sales Trend -->
                        <h4 class="mt-4">Monthly Sales Trend (Last 12 Months)</h4>
                        <t t-set="sales_trend" t-value="doc.get_sales_by_period(period='month', periods=12)"/>
                        <t t-if="sales_trend">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Period</th>
                                        <th class="text-end">Sales</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="sales_trend" t-as="period">
                                        <tr>
                                            <td><span t-esc="period['period'].strftime('%B %Y') if period['period'] else 'N/A'"/></td>
                                            <td class="text-end">
                                                <span t-esc="'%.2f' % (period['total'] or 0)"/> 
                                                <span t-esc="doc.currency_id.symbol"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <p class="text-muted">No sales data available for this period.</p>
                        </t>

                        <!-- Account Information -->
                        <h4 class="mt-4">Account Information</h4>
                        <table class="table table-sm">
                            <tbody>
                                <tr t-if="doc.owner_id">
                                    <td><strong>Primary Company</strong></td>
                                    <td><span t-esc="doc.owner_id.name"/></td>
                                </tr>
                                <tr t-if="doc.user_id">
                                    <td><strong>Account Manager</strong></td>
                                    <td><span t-esc="doc.user_id.name"/></td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
