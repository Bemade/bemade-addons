#. module: delivery_notification
#: model:mail.template,body_html:delivery_notification.mail_template_tracking_notification
msgid ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"    <p>Your order has been shipped with the following details:</p>\n"
"    <ul>\n"
"        <li>\n"
"            <strong>Carrier:</strong>\n"
"            <t t-set=\"picking\" t-value=\"object.picking_ids.filtered(lambda p: p.carrier_tracking_ref == tracking_ref)\"/>\n"
"            <t t-out=\"picking.carrier_id.name if picking and picking.carrier_id else 'Not specified'\"/>\n"
"        </li>\n"
"        <li>\n"
"            <strong>Tracking Number:</strong>\n"
"            <t t-out=\"tracking_ref or 'Not available'\"/>\n"
"        </li>\n"
"        <t t-if=\"tracking_url\">\n"
"            <li>\n"
"                <strong>Tracking:</strong>\n"
"                <a t-att-href=\"tracking_url\" target=\"_blank\">Click to track your shipment</a>\n"
"            </li>\n"
"        </t>\n"
"        <t t-if=\"object.client_order_ref\">\n"
"            <li>\n"
"                <strong>Your PO Number:</strong>\n"
"                <t t-out=\"object.client_order_ref\"/>\n"
"            </li>\n"
"        </t>\n"
"    </ul>\n"
"    <p>Thank you for your business!</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"    <p>Votre commande a été expédiée avec les détails suivants :</p>\n"
"    <ul>\n"
"        <li>\n"
"            <strong>Transporteur :</strong>\n"
"            <t t-set=\"picking\" t-value=\"object.picking_ids.filtered(lambda p: p.carrier_tracking_ref == tracking_ref)\"/>\n"
"            <t t-out=\"picking.carrier_id.name if picking and picking.carrier_id else 'Non spécifié'\"/>\n"
"        </li>\n"
"        <li>\n"
"            <strong>Numéro de suivi :</strong>\n"
"            <t t-out=\"tracking_ref or 'Non disponible'\"/>\n"
"        </li>\n"
"        <t t-if=\"tracking_url\">\n"
"            <li>\n"
"                <strong>Suivi :</strong>\n"
"                <a t-att-href=\"tracking_url\" target=\"_blank\">Cliquez pour suivre votre expédition</a>\n"
"            </li>\n"
"        </t>\n"
"        <t t-if=\"object.client_order_ref\">\n"
"            <li>\n"
"                <strong>Votre numéro de BC :</strong>\n"
"                <t t-out=\"object.client_order_ref\"/>\n"
"            </li>\n"
"        </t>\n"
"    </ul>\n"
"    <p>Merci pour votre confiance !</p>\n"
"</div>\n"
"        "

