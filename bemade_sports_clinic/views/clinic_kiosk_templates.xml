<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Task 1397/1433 — the public clinic sign-in kiosk (stable /clinic/kiosk).

    Patient-facing, full-screen, touch-first, on a supervised iPad web clip:
    no address bar, no back button, no home indicator escape — so every
    screen is escapable in-page and every « return to start » targets
    /clinic/kiosk. Deliberately NOT the portal layout: no navbar, no login
    link, no footer, no menu. Built on web.layout with the frontend CSS
    bundle only (no JS bundle); the only JavaScript is three tiny inline
    scripts (pairing poll, bfcache guard, idle reset), each with a
    no-JS fallback (noscript meta refresh / PRG being server-side).

    Law 25: no roster, no count, no autocomplete, no search; the result
    screen is ONE generic welcome carrying no name (#1418 queues a no-match
    behind the SAME screen); the date of birth is typed, never displayed
    back; the privacy policy is an inline <details> — no navigation, no
    off-domain link anywhere (the iPad's URL scope is severely filtered).
    Rendering is FRENCH regardless of the browser language; « English » is a
    per-request toggle that resets for each fresh visitor. Nothing here ever
    touches localStorage/sessionStorage.
-->
<odoo>
    <data>

        <!-- shared shell -->
        <template id="clinic_kiosk_layout" name="Clinic Kiosk Layout">
            <t t-call="web.layout">
                <t t-set="title">Clinic sign-in</t>
                <t t-set="html_data" t-value="{'lang': request.env.lang, 'class': 'o_sc_kiosk_html'}"/>
                <t t-set="body_classname" t-value="'o_sc_kiosk_body'"/>
                <t t-set="head">
                    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover"/>
                    <meta name="robots" content="noindex, nofollow"/>
                    <meta t-if="refresh_url" http-equiv="refresh"
                          t-att-content="'%s; url=%s' % (refresh_seconds, refresh_url)"/>
                    <noscript t-if="noscript_refresh_url">
                        <meta http-equiv="refresh"
                              t-att-content="'%s; url=%s' % (noscript_refresh_seconds, noscript_refresh_url)"/>
                    </noscript>
                    <t t-call-assets="web.assets_frontend" t-js="false"/>
                    <style>
                        .o_sc_kiosk_body { min-height: 100vh; background: var(--bs-light, #f8f9fa); }
                        .o_sc_kiosk {
                            max-width: 34rem; margin: 0 auto;
                            padding-top: calc(2rem + env(safe-area-inset-top, 0px));
                            padding-right: calc(1.25rem + env(safe-area-inset-right, 0px));
                            padding-bottom: calc(3rem + env(safe-area-inset-bottom, 0px));
                            padding-left: calc(1.25rem + env(safe-area-inset-left, 0px));
                        }
                        .o_sc_kiosk .form-control { font-size: 1.5rem; padding: 0.9rem 1rem; min-height: 3.75rem; }
                        .o_sc_kiosk .form-label { font-size: 1.15rem; font-weight: 600; }
                        .o_sc_kiosk .btn-lg { font-size: 1.5rem; padding: 1rem 1.5rem; min-height: 4.25rem; }
                        .o_sc_kiosk_result { font-size: 1.5rem; }
                        .o_sc_kiosk_result .o_sc_kiosk_icon { font-size: 5rem; line-height: 1; }
                        .o_sc_kiosk_code {
                            font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                            font-size: 4.5rem; font-weight: 700; letter-spacing: 0.75rem;
                            line-height: 1.2; text-indent: 0.75rem; /* re-center: tracking pads the right */
                        }
                        .o_sc_kiosk_policy summary { cursor: pointer; font-weight: 600; min-height: 2.75rem; display: list-item; }
                        .o_sc_kiosk_lang { min-height: 2.75rem; display: inline-flex; align-items: center; }
                    </style>
                </t>
                <main class="o_sc_kiosk" role="main">
                    <t t-out="0"/>
                </main>
                <!-- bfcache guard: a back-gesture restore must never resurface
                     a previous visitor's screen or half-typed form. -->
                <script>
                    window.addEventListener('pageshow', function (ev) {
                        if (ev.persisted) { window.location.reload(); }
                    });
                </script>
                <script t-if="idle_seconds" t-att-data-idle-seconds="idle_seconds">
                    (function () {
                        var node = document.currentScript;
                        var ms = parseInt(node.getAttribute('data-idle-seconds'), 10) * 1000;
                        if (!ms) { return; }
                        var timer = null;
                        function reset() {
                            if (timer) { clearTimeout(timer); }
                            timer = setTimeout(function () {
                                window.location.replace('/clinic/kiosk');
                            }, ms);
                        }
                        ['touchstart', 'pointerdown', 'mousedown', 'keydown', 'input'].forEach(function (name) {
                            document.addEventListener(name, reset, {passive: true});
                        });
                        reset();
                    })();
                </script>
            </t>
        </template>

        <!-- the FR/EN toggle — a per-request query param, never persisted.
             The two labels are proper names: not translated. -->
        <template id="clinic_kiosk_lang_toggle" name="Clinic Kiosk Language Toggle">
            <div class="text-end" t-translation="off">
                <a t-if="not lang_en" href="/clinic/kiosk?lang=en"
                   class="o_sc_kiosk_lang text-muted text-decoration-none">English</a>
                <a t-else="" href="/clinic/kiosk"
                   class="o_sc_kiosk_lang text-muted text-decoration-none">Français</a>
            </div>
        </template>

        <!-- the pairing screen: an unbound device knows nothing but its code -->
        <template id="clinic_kiosk_pairing" name="Clinic Kiosk Pairing">
            <t t-call="bemade_sports_clinic.clinic_kiosk_layout">
                <t t-call="bemade_sports_clinic.clinic_kiosk_lang_toggle"/>
                <div class="text-center py-4">
                    <h1 class="h3 mb-4">Sign-in kiosk</h1>
                    <p class="fs-5 mb-4">Ask your therapist to activate this kiosk.</p>
                    <div class="o_sc_kiosk_code my-4" t-esc="pairing_code"/>
                    <p class="text-muted fs-5 mb-2">
                        Give this code to your therapist: they enter it on their clinic page and this screen continues by itself.
                    </p>
                    <p class="text-muted small mb-0">The code renews every few minutes.</p>
                </div>
                <script t-att-data-poll-seconds="poll_seconds"
                        t-att-data-code-seconds-left="code_seconds_left">
                    (function () {
                        var node = document.currentScript;
                        var poll = parseInt(node.getAttribute('data-poll-seconds'), 10) * 1000;
                        var left = parseInt(node.getAttribute('data-code-seconds-left'), 10);
                        if (left > 0) {
                            setTimeout(function () {
                                window.location.replace('/clinic/kiosk');
                            }, (left + 1) * 1000);
                        }
                        setInterval(function () {
                            fetch('/clinic/kiosk/poll', {cache: 'no-store', credentials: 'same-origin'})
                                .then(function (response) { return response.json(); })
                                .then(function (data) {
                                    if (data) {
                                        if (data.bound) { window.location.replace('/clinic/kiosk'); }
                                    }
                                })
                                .catch(function () {});
                        }, poll);
                    })();
                </script>
            </t>
        </template>

        <!-- the form (inputs kept in the upper two-thirds: the on-screen
             keyboard covers the lower third of the iPad) -->
        <template id="clinic_kiosk_form" name="Clinic Kiosk Sign-in Form">
            <t t-call="bemade_sports_clinic.clinic_kiosk_layout">
                <t t-call="bemade_sports_clinic.clinic_kiosk_lang_toggle"/>
                <div class="text-center mb-4">
                    <h1 class="h2 mb-1"><t t-esc="clinic_name"/></h1>
                    <div class="text-muted fs-5"><t t-esc="clinic_when"/></div>
                </div>
                <h2 class="h4 text-center mb-4">Sign in for your visit</h2>
                <div t-if="incomplete" class="alert alert-warning fs-5" role="alert">
                    Please fill in every field.
                </div>
                <form t-att-action="signin_url" method="post" autocomplete="off">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input t-if="lang_en" type="hidden" name="lang" value="en"/>
                    <div class="mb-3">
                        <label class="form-label" for="kiosk_first_name">First name</label>
                        <input type="text" class="form-control" id="kiosk_first_name" name="first_name"
                               autocomplete="off" autocapitalize="words" autocorrect="off" spellcheck="false"
                               required="required" maxlength="80"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="kiosk_last_name">Last name</label>
                        <input type="text" class="form-control" id="kiosk_last_name" name="last_name"
                               autocomplete="off" autocapitalize="words" autocorrect="off" spellcheck="false"
                               required="required" maxlength="80"/>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="kiosk_dob">Date of birth</label>
                        <input type="date" class="form-control" id="kiosk_dob" name="date_of_birth"
                               autocomplete="off" required="required" min="1900-01-01"/>
                    </div>
                    <details class="o_sc_kiosk_policy mb-4">
                        <summary>Privacy policy</summary>
                        <div class="pt-2 text-muted">
                            <!-- Condensed, kiosk-scoped version of the Law 25
                                 policy (owner-approved 2026-09-06); the full
                                 policy is the fitcrew_privacy_policy website
                                 page. Same-host link only (kiosk rule). -->
                            <p class="mb-2">
                                Your first name, last name and date of birth are collected only to signal your arrival to this clinic's therapy team. Nothing you type is shown to other visitors, and no health information is requested at this kiosk.
                            </p>
                            <p class="mb-2">
                                Your sign-in is matched to your athlete file; access is limited to the staff responsible for your follow-up. A sign-in that matches no file is deleted automatically a few days after the clinic.
                            </p>
                            <p class="mb-2">
                                Data is hosted in Quebec. Privacy officer: Denis Durepos — admin@lefitcrew.com. You may request access to or rectification of your information, or withdraw your consent, at any time.
                            </p>
                            <p class="mb-0">
                                <a t-att-href="lang_en and '/en/politique-de-confidentialite' or '/politique-de-confidentialite'">Read the full privacy policy</a>
                            </p>
                        </div>
                    </details>
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        I have arrived
                    </button>
                </form>
                <div class="text-center mt-4">
                    <a t-att-href="home_url" class="text-muted">Done</a>
                </div>
            </t>
        </template>

        <!-- the answer: ok / duplicate / locked (« unknown » is kept for
             safety: since #1418 a no-match is queued and answers ok /
             duplicate). Generic — the PRG flag carries no name (#1433) —
             and back to the start after a few seconds. -->
        <template id="clinic_kiosk_result" name="Clinic Kiosk Result">
            <t t-call="bemade_sports_clinic.clinic_kiosk_layout">
                <div class="text-center mb-4">
                    <h1 class="h2 mb-1"><t t-esc="clinic_name"/></h1>
                    <div class="text-muted fs-5"><t t-esc="clinic_when"/></div>
                </div>
                <div class="text-center o_sc_kiosk_result py-4">
                    <t t-if="outcome == 'ok'">
                        <div class="o_sc_kiosk_icon text-success mb-3"><i class="fa fa-check-circle" aria-hidden="true"/></div>
                        <p class="mb-2"><strong>Welcome!</strong></p>
                        <p class="mb-0">You are signed in. Please have a seat — the therapist will call you.</p>
                    </t>
                    <t t-elif="outcome == 'duplicate'">
                        <div class="o_sc_kiosk_icon text-info mb-3"><i class="fa fa-info-circle" aria-hidden="true"/></div>
                        <p class="mb-2"><strong>You are already signed in.</strong></p>
                        <p class="mb-0">Please have a seat — the therapist will call you.</p>
                    </t>
                    <t t-elif="outcome == 'locked'">
                        <div class="o_sc_kiosk_icon text-warning mb-3"><i class="fa fa-hourglass-half" aria-hidden="true"/></div>
                        <p class="mb-2"><strong>Too many attempts.</strong></p>
                        <p class="mb-0">Please see the therapist, or try again in a few minutes.</p>
                    </t>
                    <t t-else="">
                        <div class="o_sc_kiosk_icon text-warning mb-3"><i class="fa fa-user-times" aria-hidden="true"/></div>
                        <p class="mb-2"><strong>We could not find you.</strong></p>
                        <p class="mb-0">Please see the therapist.</p>
                    </t>
                </div>
                <div class="text-center mt-4">
                    <a t-att-href="refresh_url" class="btn btn-outline-secondary btn-lg w-100">Done</a>
                    <p class="text-muted mt-3 mb-0">This screen returns to the form by itself.</p>
                </div>
            </t>
        </template>

        <!-- ONE page for every refused dispatcher hit -->
        <template id="clinic_kiosk_inactive" name="Clinic Kiosk Inactive">
            <t t-call="bemade_sports_clinic.clinic_kiosk_layout">
                <div class="text-center o_sc_kiosk_result py-5">
                    <div class="o_sc_kiosk_icon text-muted mb-3"><i class="fa fa-power-off" aria-hidden="true"/></div>
                    <p class="mb-2"><strong>Kiosk inactive</strong></p>
                    <p class="mb-0">Please see the therapist.</p>
                </div>
            </t>
        </template>

    </data>
</odoo>
