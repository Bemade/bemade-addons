#. module: bemade_sports_clinic
#: model:mail.template,body_html:bemade_sports_clinic.mail_template_urgent_summary
msgid ""
"<div>\n"
"                    <p>Bonjour, / Hello,</p>\n"
"                    <p>Activité urgente sur vos équipes : / Urgent activity on your teams:</p>\n"
"                    <t t-foreach=\"ctx.get('urgent_teams') or []\" t-as=\"team\">\n"
"                        <div style=\"margin-bottom:12px;\">\n"
"                            <p><strong t-out=\"team['name']\"/></p>\n"
"                            <ul>\n"
"                                <li t-if=\"team['status_changes']\">\n"
"                                    <t t-out=\"team['status_changes']\"/> changement(s) de statut de jeu / play-status change(s)\n"
"                                </li>\n"
"                                <li t-if=\"team['new_injuries']\">\n"
"                                    <t t-out=\"team['new_injuries']\"/> nouvelle(s) blessure(s) / new injury/injuries\n"
"                                </li>\n"
"                                <t t-foreach=\"team['events'] or []\" t-as=\"ev\">\n"
"                                    <li>\n"
"                                        Nouvel événement à court préavis / Short-notice new event:\n"
"                                        <strong t-out=\"ev['name']\"/>\n"
"                                        <t t-if=\"ev.get('date_label') or ev['date_start']\"> — <t t-out=\"ev.get('date_label') or format_datetime(ev['date_start'])\"/></t>\n"
"                                    </li>\n"
"                                </t>\n"
"                            </ul>\n"
"                            <p t-if=\"team['url']\">\n"
"                                <a t-att-href=\"team['url']\">Tableau de bord / Team dashboard</a>\n"
"                            </p>\n"
"                        </div>\n"
"                    </t>\n"
"                    <p style=\"color:#888;font-size:12px;\">\n"
"                        Aucune donnée médicale n'est incluse. / No medical data is included.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

#. module: bemade_sports_clinic
#: model:mail.template,body_html:bemade_sports_clinic.mail_template_morning_digest
msgid ""
"<div>\n"
"                    <p>Bonjour, / Hello,</p>\n"
"                    <p>Votre sommaire quotidien d'équipe : / Your daily team briefing:</p>\n"
"                    <p style=\"color:#888;font-size:12px;\">\n"
"                        Changements des dernières <t t-out=\"ctx.get('digest_window_hours') or 24\"/> h /\n"
"                        Changes over the last <t t-out=\"ctx.get('digest_window_hours') or 24\"/> h.\n"
"                    </p>\n"
"                    <t t-foreach=\"ctx.get('digest_teams') or []\" t-as=\"team\">\n"
"                        <div style=\"margin-bottom:12px;\">\n"
"                            <p><strong t-out=\"team['name']\"/></p>\n"
"                            <div t-if=\"team.get('announcement')\" style=\"margin:6px 0;\">\n"
"                                <p style=\"margin:0 0 2px 0;\">\n"
"                                    <strong>Annonce de l'équipe / Team announcement<t t-if=\"team.get('announcement_is_expired')\"> (expirée / expired)</t>:</strong>\n"
"                                </p>\n"
"                                <p style=\"white-space:pre-wrap;margin:0;\" t-out=\"team['announcement']\"/>\n"
"                            </div>\n"
"                            <ul>\n"
"                                <li>\n"
"                                    <t t-out=\"team['red']\"/> indisponible(s) / no-play<t t-out=\"team['red_delta_str']\"/>\n"
"                                    ·\n"
"                                    <t t-out=\"team['yellow']\"/> limité(s) / limited<t t-out=\"team['yellow_delta_str']\"/>\n"
"                                </li>\n"
"                                <li t-if=\"team['new_injuries']\">\n"
"                                    <t t-out=\"team['new_injuries']\"/> nouvelle(s) blessure(s) (<t t-out=\"ctx.get('digest_window_hours') or 24\"/> h) / new injury/injuries\n"
"                                </li>\n"
"                                <li t-if=\"team['changes']\">\n"
"                                    <t t-out=\"team['changes']\"/> joueur(s) avec changements (<t t-out=\"ctx.get('digest_window_hours') or 24\"/> h) / player(s) with changes\n"
"                                </li>\n"
"                                <li t-if=\"team['pending_verify']\">\n"
"                                    <t t-out=\"team['pending_verify']\"/> vérification(s) de blessure en attente / injury verification(s) pending\n"
"                                </li>\n"
"                                <li t-if=\"team['pending_removal']\">\n"
"                                    <t t-out=\"team['pending_removal']\"/> demande(s) de retrait de joueur / player removal request(s)\n"
"                                </li>\n"
"                            </ul>\n"
"                            <p t-if=\"team['url']\">\n"
"                                <a t-att-href=\"team['url']\">Tableau de bord / Team dashboard</a>\n"
"                            </p>\n"
"                        </div>\n"
"                    </t>\n"
"                    <t t-if=\"ctx.get('digest_events')\">\n"
"                        <div style=\"margin-bottom:12px;\">\n"
"                            <p><strong>Événements à venir (7 j) / Upcoming events (7d):</strong></p>\n"
"                            <ul>\n"
"                                <t t-foreach=\"ctx.get('digest_events') or []\" t-as=\"ev\">\n"
"                                    <li>\n"
"                                        <strong t-out=\"ev['name']\"/>\n"
"                                        <t t-if=\"ev.get('date_label') or ev['date_start']\"> — <t t-out=\"ev.get('date_label') or format_datetime(ev['date_start'])\"/></t>\n"
"                                    </li>\n"
"                                </t>\n"
"                            </ul>\n"
"                            <p style=\"color:#888;font-size:12px;\">\n"
"                                Les événements non listés sont hors de notre plan de couverture, avisez-nous. /\n"
"                                Events not listed are outside our coverage plan — please advise us.\n"
"                            </p>\n"
"                        </div>\n"
"                    </t>\n"
"                    <p style=\"color:#888;font-size:12px;\">\n"
"                        Aucune donnée médicale n'est incluse. / No medical data is included.\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""

