        <record id="mail_activity_type_portal_team_coach_rule" model="ir.rule">
            <field name="name">Portal Team Coach: Mail Activity Type Read Access</field>
            <field name="model_id" ref="mail.model_mail_activity_type"/>
            <field name="domain_force">[
                '|', '|', '|', '|',
                ('res_model', '=', False),
                ('res_model', '=', 'sports.patient'),
                ('res_model', '=', 'sports.patient.injury'),
