<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default OpenWebUI Configuration -->
        <record id="config_openwebui_url" model="ir.config_parameter">
            <field name="key">mail_manual_routing_ai.openwebui_url</field>
            <field name="value">https://ai.3387.vezina.biz</field>
        </record>

        <record id="config_openwebui_model" model="ir.config_parameter">
            <field name="key">mail_manual_routing_ai.openwebui_model</field>
            <field name="value">glm-5:cloud</field>
        </record>

        <record id="config_auto_classify" model="ir.config_parameter">
            <field name="key">mail_manual_routing_ai.auto_classify</field>
            <field name="value">False</field>
        </record>

        <record id="config_min_confidence" model="ir.config_parameter">
            <field name="key">mail_manual_routing_ai.min_confidence</field>
            <field name="value">80.0</field>
        </record>
    </data>
</odoo>
