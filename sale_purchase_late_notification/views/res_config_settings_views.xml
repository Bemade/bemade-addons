<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Late Notification Settings (in Sales app settings) -->
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.late.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Late Order Notifications" name="sale_late_notifications">
                    <setting id="sale_late_notification_enabled" string="Enable Late Order Notifications" help="Automatically create activities for late sale orders">
                        <field name="sale_late_notification_enabled"/>
                        <div class="content-group" invisible="not sale_late_notification_enabled">
                            <div class="row mt16">
                                <label for="sale_late_notification_days" class="col-3 o_light_label"/>
                                <field name="sale_late_notification_days" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="sale_late_activity_summary" class="col-3 o_light_label"/>
                                <field name="sale_late_activity_summary" class="col-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="sale_late_activity_user_id" class="col-3 o_light_label"/>
                                <field name="sale_late_activity_user_id" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="sale_late_renotify_cooldown_days" class="col-3 o_light_label"/>
                                <field name="sale_late_renotify_cooldown_days" class="col-3"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Late Notification Settings (in Purchase app settings) -->
    <record id="res_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.late.notification</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="after">
                <block title="Late Order Notifications" name="purchase_late_notifications">
                    <setting id="purchase_late_notification_enabled" string="Enable Late Order Notifications" help="Automatically create activities for late purchase orders">
                        <field name="purchase_late_notification_enabled"/>
                        <div class="content-group" invisible="not purchase_late_notification_enabled">
                            <div class="row mt16">
                                <label for="purchase_late_notification_days" class="col-3 o_light_label"/>
                                <field name="purchase_late_notification_days" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="purchase_late_activity_summary" class="col-3 o_light_label"/>
                                <field name="purchase_late_activity_summary" class="col-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="purchase_late_activity_user_id" class="col-3 o_light_label"/>
                                <field name="purchase_late_activity_user_id" class="col-3"/>
                            </div>
                            <div class="row mt8">
                                <label for="purchase_late_renotify_cooldown_days" class="col-3 o_light_label"/>
                                <field name="purchase_late_renotify_cooldown_days" class="col-3"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
